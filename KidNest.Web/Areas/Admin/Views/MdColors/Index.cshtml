@model IEnumerable<KidNest.Web.ViewModels.MD.Colors.MdColorIndexViewModel>

@{
    ViewData["Title"] = "MD Colors";
}

<h1>MD - Colors List</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create new</a>
</p>
<div class="table-responsive">
    <table class="table table-dark table-striped table-hover align-middle text-center" id="mdColorsTable">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Id)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.IsActive)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CreatedDate)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Id)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @if (item.IsActive.HasValue)
                        {
                            if (item.IsActive.Value)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary">N/A</span>
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedDate)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-controller="MdColors" class="btn btn-sm btn-warning"
                           asp-route-id="@item.Id">Edit</a>
                        <a asp-action="Details" asp-controller="MdColors" class="btn btn-sm btn-info"
                           asp-route-id="@item.Id">Details</a>
                        <a asp-action="Delete" asp-controller="MdColors" class="btn btn-sm btn-danger"
                           asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#mdColorsTable').DataTable();
        });
    </script>
}