@model KidNest.Web.ViewModels.MD.Colors.MdColorEditViewModel

@{
    ViewData["Title"] = "MD - Color Modification";
}

<h1>Edit a color</h1>

<h4>MD - Color #@Model.Id</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        @await Html.PartialAsync("_ValidationSummary")
        <form asp-action="Edit" class="d-grid gap-3">
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" autofocus required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HexValue" class="control-label"></label>
                <input asp-for="HexValue" class="form-control form-control-color" type="color" />
                <span asp-validation-for="HexValue" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" /> |
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
