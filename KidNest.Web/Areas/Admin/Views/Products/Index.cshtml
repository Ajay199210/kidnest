@{
    ViewData["Title"] = "Products";
}

<h1>Products List</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create new</a>
</p>

<div class="table-responsive">
    <table class="table table-dark table-striped table-hover align-middle text-center" id="productsTable">
        <thead class="border">
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Discount</th>
                <th>Quantity</th>
                <th>Barcode</th>
            </tr>
        </thead>
        <tbody>
            <!-- Filled dynamically by DataTables -->
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const table = $('#productsTable').DataTable({
                processing: false, // show visual processing indicator
                serverSide: true, // enable server side processing
                stateSave: true, // preserves sort/pagination state
                ajax: {
                    url: '@Url.Action("GetProductsData", "Products")',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    data: function (d) {
                        return JSON.stringify(d);
                    }
                },
                columns: [
                    { data: 'name', name: 'Name' },
                    { data: 'categoryName', name: 'CategoryName' },
                    {
                        data: 'price',
                        render: function (data) {
                            const parsed = parseFloat(data);
                            return isNaN(parsed) ? '<span class="text-secondary">N/A</span>' : `${parsed.toFixed(2)} $`;
                        }
                    },
                    { 
                        data: 'discount',
                        render: function (data) {
                            return (data === null || data === undefined) ?
                                '<span class="text-secondary">N/A</span>' : `${data}%`
                        }
                    },
                    { data: 'quantity' },
                    { data: 'barcode' },
                    {
                        data: 'id',
                        render: function (data) {
                            return `
                                <a href="/Admin/Products/Edit/${data}" class="btn btn-sm btn-warning">Edit</a>
                                <a href="/Admin/Products/Details/${data}" class="btn btn-sm btn-info">Details</a>
                                <a href="/Admin/Products/Delete/${data}" class="btn btn-sm btn-danger">Delete</a>`;
                        },
                        orderable: false
                    },
                ]
            });
        });
    </script>
}
