@model KidNest.Web.ViewModels.Products.ProductViewModel

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>

<div>
    <h4>Product #@Model.Id: @Model.Name</h4>
    <img src="@Model.ImagePath" alt="Product Image" class="img-fluid img-thumbnail" style="max-height: 200px;" />
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CategoryName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CategoryName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Barcode)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Barcode)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10 text-break">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Discount)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Discount)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DiscountedPrice)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DiscountedPrice)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Quantity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Quantity)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ImagePath)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ImagePath)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Variants)
        </dt>
        @if (Model.Variants.Count > 0)
        {
            <dd class="col-sm-10">
                <table class="table align-items-middle text-center table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Variant Id</th>
                            <th>Color</th>
                            <th>Size</th>
                            <th>Barcode</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var variant in Model.Variants)
                        {
                            <tr>
                                <td>@variant.Id</td>
                                @if(variant.Color != null)
                                {
                                    <td>
                                        <span class="color-circle" style="background-color: @variant.ColorHex;"></span>
                                        @variant.Color
                                    </td>
                                }
                                else
                                {
                                    <td class="text-muted">N/A</td>
                                }
                                <td class="@(variant.SizeCode ?? "text-muted")">
                                    @(variant.SizeCode ?? "N/A")
                                </td>
                                <td>@variant.Barcode</td>
                                <td>@variant.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </dd>
        }
        else
        {
            <dd class="col-sm-10 text-muted">No variants available</dd>
        }
       
        @if(Model.NewReleaseUntil != null)
        {
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.NewReleaseUntil)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.NewReleaseUntil)
            </dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-controller="Products" class="btn btn-warning" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
