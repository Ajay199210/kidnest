@{
    ViewData["Title"] = "Orders";
}

<h1>Orders List</h1>

<div class="table-responsive">
    <table class="table table-dark table-striped table-hover align-middle text-center" id="ordersTable">
        <thead class="border">
            <tr>
                <th>Order Date</th>
                <th>User Email</th>
                <th>Status</th>
                <th>Total Items</th>
                <th>Total Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const table = $('#ordersTable').DataTable({
                processing: false,
                serverSide: true,
                stateSave: true,
                ajax: {
                    url: '@Url.Action("GetOrdersData", "Orders")',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    data: function (d) {
                        // Send the DataTable request parameters to the server
                        return JSON.stringify(d);
                    }
                },
                columns: [
                    {
                        data: 'orderDate',
                        render: function (data) {
                            return data ? new Date(data).toLocaleDateString() : '';
                        }
                    },
                    { data: 'userEmail' },
                    { data: 'status' },
                    { data: 'totalItemCount' },
                    {
                        data: 'totalOrderPrice',
                        render: function (data) {
                            return parseFloat(data).toFixed(2) + " $";
                        }
                    },
                    {
                        data: 'id',
                        render: function (data) {
                            return `
                                <a href="/Admin/Orders/Details/${data}" class="btn btn-sm btn-info">Details</a>
                                <a href="/Admin/Orders/Delete/${data}" class="btn btn-sm btn-danger">Delete</a>`;
                        },
                        orderable: false
                    }
                ]
            });
        });
    </script>
}
