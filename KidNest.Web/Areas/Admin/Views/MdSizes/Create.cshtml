@model KidNest.Web.ViewModels.MD.Sizes.MdSizeCreateViewModel

@{
    ViewData["Title"] = "MD - Size Creation";
}

<h1>New size</h1>

<h4>Add a new size</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" class="d-grid gap-3">
            @await Html.PartialAsync("_ValidationSummary")
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SizeCode" class="control-label"></label>
                <input asp-for="SizeCode" class="form-control" />
                <span asp-validation-for="SizeCode" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" /> |
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

