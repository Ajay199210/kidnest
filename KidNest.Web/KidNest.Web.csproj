<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.7" />
    <PackageReference Include="NToastNotify" Version="8.0.0" />
    <PackageReference Include="Twilio" Version="7.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KidNest.Services\KidNest.Services.csproj" />
  </ItemGroup>

  <!-- On publish: flatten wwwroot into publish root for MonsterASP (single wwwroot) -->
  <Target Name="FlattenWebRoot" AfterTargets="Publish">
    <ItemGroup>
      <_WwwrootFiles Include="$(PublishDir)wwwroot\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WwwrootFiles)"
          DestinationFiles="@(_WwwrootFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(PublishDir)wwwroot" />
  </Target>

</Project>
