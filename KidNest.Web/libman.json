{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "bootstrap@5.3.3",
      "destination": "wwwroot/lib/bootstrap/"
    },
    {
      "library": "font-awesome@6.7.2",
      "destination": "wwwroot/lib/font-awesome/"
    },
    {
      "library": "sweetalert2@11.16.1",
      "destination": "wwwroot/lib/sweetalert2/",
      "files": [
        "sweetalert2.min.js",
        "sweetalert2.min.css"
      ]
    },
    {
      "library": "elevatezoom@2.2.3",
      "destination": "wwwroot/lib/elevatezoom/"
    },
    {
      "library": "microsoft-signalr@8.0.7",
      "destination": "wwwroot/lib/microsoft-signalr/"
    },
    {
      "library": "select2@4.0.13",
      "destination": "wwwroot/lib/select2/",
      "files": [
        "js/select2.min.js",
        "css/select2.min.css"
      ]
    }
  ]
}