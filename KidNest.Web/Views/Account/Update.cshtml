@model KidNest.Web.ViewModels.Users.UserEditViewModel;

@{
    ViewData["Title"] = "Update account";
}

<div class="auth-page min-vh-100 d-flex justify-content-center align-items-center">
    <div class="row w-100 justify-content-center">
        <div class="col-md-6 col-lg-4 m-4 p-4 p-md-5 pb-4 auth-form-card rounded-4">
            <div class="text-center mb-3">
                <a asp-action="Index" asp-controller="Home">
                    <img src="~/img/logo/logo.png" class="auth-form-logo img-fluid" alt="Logo">
                </a>
            </div>
            <div class="mt-0">
                <h3 class="fw-bold mb-1">@User.Identity!.Name</h3>
                <p class="text-muted small mb-3">Update your account details below.</p>
            </div>
            <form asp-action="Update" novalidate id="updateForm">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div class="mb-3">
                    <label for="inputFullName" class="form-label small fw-semibold">Full Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-user text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" id="inputFullName"
                               placeholder="Full Name" asp-for="FullName" autofocus>
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="InputUsernameEmail" class="form-label small fw-semibold">Email or Phone</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                        <input class="form-control border-start-0" id="InputUsernameEmail"
                               placeholder="Phone number or email" asp-for="EmailOrPhone">
                    </div>
                    <span asp-validation-for="EmailOrPhone" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="inputUserAddress" class="form-label small fw-semibold">Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-map-marker-alt text-muted"></i></span>
                        <input class="form-control border-start-0" id="inputUserAddress"
                               placeholder="Your delivery address" asp-for="Address">
                    </div>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="inputPassword" class="form-label small fw-semibold">Current Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-lock text-muted"></i></span>
                        <input type="password" class="form-control border-start-0 border-end-0"
                               id="inputPassword" placeholder="Current password" asp-for="Password" />
                        <span class="input-group-text bg-white border-start-0 auth-eye-toggle" id="togglePassword">
                            <i class="fa-solid fa-eye text-muted"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="inputNewPassword" class="form-label small fw-semibold">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-key text-muted"></i></span>
                        <input type="password" class="form-control border-start-0"
                               id="inputNewPassword" placeholder="New password" asp-for="NewPassword" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="inputConfirmPassword" class="form-label small fw-semibold">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-lock text-muted"></i></span>
                        <input type="password" class="form-control border-start-0" id="inputConfirmPassword"
                               placeholder="Confirm new password" asp-for="ConfirmNewPassword" />
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>
                <button type="submit" id="saveChangesBtn" class="btn btn-cart rounded-pill w-100 fw-semibold py-2">
                    <i class="fas fa-save me-1"></i> SAVE CHANGES
                </button>
                <button type="button" id="btnCloseAccount" class="btn btn-outline-danger rounded-pill w-100 mt-2 fw-semibold py-2"
                    data-bs-toggle="modal" data-bs-target="#confirmCloseAccountModal">
                    <i class="fas fa-user-slash me-1"></i> CLOSE ACCOUNT
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Account Closure Confirmation Modal (outside auth-page for proper z-index) -->
<div class="modal fade" id="confirmCloseAccountModal" tabindex="-1" aria-labelledby="confirmCloseAccountLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmCloseAccountLabel">Confirm Account Closure</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Delete" asp-controller="Account" method="post" id="deleteAccountForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p class="mb-3">Please confirm your password to permanently delete your account.</p>
                    <div class="mb-3">
                        <input type="password" class="form-control"
                            placeholder="Your password" name="Password" required />
                        <span id="deleteError" class="text-danger d-none my-1" role="alert"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill">Yes, close account</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#updateForm').on('submit', function () {
            $('#saveChangesBtn').prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Saving...');
        });

        document.addEventListener('DOMContentLoaded', function() {
            // Toggle password
            const togglePassword = document.getElementById("togglePassword");
            const inputPassword = document.getElementById("inputPassword");
            const eyeIcon = togglePassword.querySelector('i');

            togglePassword.addEventListener('click', function () {

                if (inputPassword.type == 'password') {
                    inputPassword.type = 'text';
                    eyeIcon.classList.remove('fa-eye');
                    eyeIcon.classList.add('fa-eye-slash');
                } else {
                    inputPassword.type = 'password';
                    eyeIcon.classList.remove('fa-eye-slash');
                    eyeIcon.classList.add('fa-eye');
                }
            });

            // Delete user account
            $('#deleteAccountForm').on('submit', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var form = $(this);
                var formData = form.serialize();
                var errorDiv = $('#deleteError');
                errorDiv.addClass('d-none').text('');

                var $closeBtn = form.find('button[type="submit"]');
                var origCloseBtnHtml = $closeBtn.html();
                $closeBtn.prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Processing...');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: formData,
                    dataType: 'json',
                    success: function (response, status, xhr) {
                        if (xhr.status === 204) {
                            $('#confirmCloseAccountModal').modal('hide');
                            Swal.fire({
                                icon: 'success',
                                title: 'Account Deleted',
                                text: 'Your account has been deleted successfully!',
                                footer: '<a href="/account/register">Create a new account?</a>',
                                allowOutsideClick: false
                            }).then(() => {
                                window.location.href = '/';
                            });
                        }
                        else if (response && response.success) {
                            $('#confirmCloseAccountModal').modal('hide');
                            window.location.href = response.redirectUrl || '/';
                        }
                    },
                    error: function (xhr) {
                        $closeBtn.prop('disabled', false).html(origCloseBtnHtml);

                        let error = xhr.responseJSON || { message: "An unknown error occurred." };
                        let messages = [];

                        if (error.errors && Array.isArray(error.errors)) {
                            messages = error.errors;
                        } else if (error.message) {
                            messages.push(error.message);
                        }

                        const errorDiv = $('#deleteError');
                        errorDiv.html(messages.join('<br>')).removeClass('d-none');
                    }
                });
            });
        });
    </script>
}
