@model KidNest.Web.ViewModels.Users.UserRegisterViewModel;

@{
    ViewData["Title"] = "Create a new account";
}

<div class="auth-page min-vh-100 d-flex justify-content-center align-items-center">
    <div class="row w-100 justify-content-center">
        <div class="col-md-6 col-lg-4 m-4 p-4 p-md-5 pb-4 auth-form-card rounded-4">
            <div class="text-center mb-3">
                <a asp-action="Index" asp-controller="Home">
                    <img src="~/img/logo/logo.png" class="auth-form-logo img-fluid" alt="Logo">
                </a>
            </div>
            <div class="mt-0">
                <h3 class="fw-bold mb-1">Create an account</h3>
                <p class="text-muted small mb-3">Join KidNest and start shopping for your little ones.</p>
            </div>
            @await Html.PartialAsync("_ValidationSummary")
            <form asp-action="Register" novalidate id="registerForm">
                <div class="mb-3">
                    <label for="inputFullName" class="form-label small fw-semibold">Full Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-user text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" id="inputFullName"
                               placeholder="Full Name" asp-for="FullName" autofocus>
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="inputUsernameEmail" class="form-label small fw-semibold">Email or Phone</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                        <input class="form-control border-start-0" id="inputUsernameEmail"
                               placeholder="Phone number or email" asp-for="EmailOrPhone">
                    </div>
                    <span asp-validation-for="EmailOrPhone" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="inputUserAddress" class="form-label small fw-semibold">Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-map-marker-alt text-muted"></i></span>
                        <input class="form-control border-start-0" id="inputUserAddress"
                               placeholder="Your delivery address" asp-for="Address">
                    </div>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="inputPassword" class="form-label small fw-semibold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-lock text-muted"></i></span>
                        <input type="password" class="form-control border-start-0 border-end-0"
                               id="inputPassword" placeholder="Password" asp-for="Password" />
                        <span class="input-group-text bg-white border-start-0 auth-eye-toggle" id="togglePassword">
                            <i class="fa-solid fa-eye text-muted"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="inputConfirmPassword" class="form-label small fw-semibold">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-lock text-muted"></i></span>
                        <input type="password" class="form-control border-start-0"
                               id="inputConfirmPassword" placeholder="Confirm password" asp-for="ConfirmPassword" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" id="registerSubmitBtn" class="btn btn-cart rounded-pill w-100 fw-semibold py-2">
                    <i class="fas fa-user-plus me-1"></i> CREATE ACCOUNT
                </button>
            </form>
            <div class="text-center mt-3 small">
                Already have an account?
                <a asp-action="Login" asp-controller="Account" class="fw-semibold text-decoration-none" style="color: var(--bs-primary-text-emphasis);">Login here</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#registerForm').on('submit', function () {
            $('#registerSubmitBtn').prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Creating account...');
        });

        document.addEventListener('DOMContentLoaded', function() {
            // Toggle password
            const togglePassword = document.getElementById("togglePassword");
            const inputPassword = document.getElementById("inputPassword");
            const eyeIcon = togglePassword.querySelector('i');

            togglePassword.addEventListener('click', function () {

                if (inputPassword.type == 'password') {
                    inputPassword.type = 'text';
                    eyeIcon.classList.remove('fa-eye');
                    eyeIcon.classList.add('fa-eye-slash');
                } else {
                    inputPassword.type = 'password';
                    eyeIcon.classList.remove('fa-eye-slash');
                    eyeIcon.classList.add('fa-eye');
                }
            });
        });
    </script>
}