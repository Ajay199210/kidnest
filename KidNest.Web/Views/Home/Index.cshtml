@model KidNest.Web.ViewModels.Home.IndexPageViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Carousel -->
@await Component.InvokeAsync("Carousel")

<!-- Products Grid or Default Categories -->
@if (Model.ProductsGrid != null)
{
    <!-- Search Results Grid -->
    @await Html.PartialAsync("_ProductsGridPartial", Model.ProductsGrid)
}
else if (Model.Categories.Count > 0)
{
    <!-- Category Sections -->
    <div class="container-fluid gallery p-3 p-md-0">
        <div class="row m-0">
            <!-- Main Category Content -->
            <div class="col-md-10">
                @foreach (var category in Model.Categories)
                {
                    if (category.Products.Count > 0)
                    {
                        @await Html.PartialAsync("_CategorySectionPartial", category)
                    }
                }
            </div>

            <!-- Ads Sidebar -->
            @await Component.InvokeAsync("AdsMenu")
        </div>
    </div>
}

<!-- Parallax Section -->
@await Component.InvokeAsync("PublicSettings", new { section = "Parallax" })
