@model KidNest.Web.ViewModels.Home.IndexPageViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Products Grid or Default Categories -->
@if (Model.ProductsGrid != null)
{
    <!-- Search Results Grid -->
    <section class="page-bg-gradient">
        @await Html.PartialAsync("_ProductsGridPartial", Model.ProductsGrid)
    </section>
}
else if (Model.Categories.Count > 0)
{
    <!-- Hero: Carousel + Welcome Banner -->
    <div class="hero-wrapper">
        @await Component.InvokeAsync("Carousel")
        <!-- Welcome Banner -->
        <div class="products-grid-banner text-center py-3 py-md-4 px-3 position-relative overflow-hidden">
        <span class="banner-circle banner-circle-1"></span>
        <span class="banner-circle banner-circle-2"></span>
        <span class="banner-circle banner-circle-3"></span>
        <span class="banner-circle banner-circle-4"></span>
        <span class="banner-circle banner-circle-5"></span>
        <span class="banner-circle banner-circle-6"></span>
        <span class="banner-star banner-star-1"></span>
        <span class="banner-star banner-star-2"></span>
        <span class="banner-star banner-star-3"></span>
        <span class="banner-star banner-star-4"></span>
        <!-- Floating toy icons -->
        <span class="banner-float-icon" style="--fi-x:5%;  --fi-size:1.2rem; --fi-dur:5s;   --fi-delay:0s;"><i class="fas fa-star"></i></span>
        <span class="banner-float-icon" style="--fi-x:15%; --fi-size:1.1rem; --fi-dur:4s;   --fi-delay:1.2s;"><i class="fas fa-heart"></i></span>
        <span class="banner-float-icon" style="--fi-x:27%; --fi-size:1.4rem; --fi-dur:6s;   --fi-delay:0.5s;"><i class="fas fa-gift"></i></span>
        <span class="banner-float-icon" style="--fi-x:42%; --fi-size:1.2rem; --fi-dur:4.5s; --fi-delay:2.5s;"><i class="fas fa-puzzle-piece"></i></span>
        <span class="banner-float-icon" style="--fi-x:57%; --fi-size:1.3rem; --fi-dur:5.5s; --fi-delay:0.8s;"><i class="fas fa-gamepad"></i></span>
        <span class="banner-float-icon" style="--fi-x:70%; --fi-size:1.1rem; --fi-dur:4s;   --fi-delay:1.8s;"><i class="fas fa-star"></i></span>
        <span class="banner-float-icon" style="--fi-x:80%; --fi-size:1.4rem; --fi-dur:5s;   --fi-delay:3s;"><i class="fas fa-baby"></i></span>
        <span class="banner-float-icon" style="--fi-x:91%; --fi-size:1.2rem; --fi-dur:4.5s; --fi-delay:1s;"><i class="fas fa-heart"></i></span>
        <div class="position-relative" style="z-index: 1;">
            <i class="fas fa-heart fs-2 mb-2 d-block banner-heart-icon" style="color: var(--bs-primary-text-emphasis);"></i>
            <h1 class="fw-bold mb-1" style="font-family: 'Dancing Script', cursive; font-size: 2.2rem;">
                Welcome to KidNest
            </h1>
            <div class="d-flex justify-content-center align-items-center gap-2 mt-2">
                <span class="d-inline-block rounded-pill" style="width: 40px; height: 3px; background-color: var(--bs-primary);"></span>
                <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: var(--bs-primary);"></span>
                <span class="d-inline-block rounded-pill" style="width: 40px; height: 3px; background-color: var(--bs-primary);"></span>
            </div>
            <p class="text-muted mt-2 mb-0" style="max-width: 480px; margin-left: auto; margin-right: auto; font-family: 'Nunito', sans-serif; font-size: 1.05rem;">
                Everything your little ones need, all in one cozy place. Browse our curated collections below!
            </p>
        </div>
    </div>
    </div><!-- /hero-wrapper -->

    <!-- Category Sections with Filter Sidebar -->
    <div class="container-fluid px-0 page-bg-gradient">
        <div class="row g-0">
            <!-- Filter Sidebar -->
            <div class="col-lg-3 d-none d-lg-block bg-white border-end filter-sidebar-col">
                @await Html.PartialAsync("_FilterSidebarPartial")
            </div>
            <!-- Categories -->
            <div class="col-lg-9 px-2 px-md-3">
                @foreach (var category in Model.Categories)
                {
                    if (category.Products.Count > 0)
                    {
                        @await Html.PartialAsync("_CategorySectionPartial", category)
                    }
                }
            </div>
        </div>
    </div>
}

<!-- Parallax Section -->
@await Component.InvokeAsync("PublicSettings", new { section = "Parallax" })
