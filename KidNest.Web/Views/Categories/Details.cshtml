@model KidNest.Web.ViewModels.Categories.CategoryProductsViewModel
@{
    ViewData["Title"] = Model.CategoryName;
}

<section class="page-bg-gradient">
<div class="container-fluid px-0">
    <div class="row g-0">
        <!-- Filter Sidebar -->
        <div class="col-lg-3 d-none d-lg-block bg-white border-end filter-sidebar-col">
            @await Html.PartialAsync("_FilterSidebarPartial")
        </div>
        <!-- Products -->
        <div class="col-lg-9 px-3 px-md-4 px-lg-4 py-4">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a class="text-dark text-decoration-none" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home me-1"></i>Home
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.CategoryName</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-4 d-lg-none">@Model.CategoryName</h2>
            <div class="row g-3 g-lg-4">
                @foreach (var productCardVM in Model.Products)
                {
                    <div class="col-12 col-sm-6 col-lg-4">
                        @await Html.PartialAsync("_ProductCardPartial", productCardVM)
                    </div>
                }
            </div>
        </div>
    </div>
</div>
</section>

<!-- Parallax Section -->
@await Component.InvokeAsync("PublicSettings", new { section = "Parallax" })