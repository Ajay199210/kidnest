@{
    ViewData["Title"] = "Something Went Wrong";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center py-5 px-3 text-center" style="min-height: calc(100vh - var(--header-h));">
    <div>
        <div class="mb-3" style="font-size: 6rem; font-weight: 900; line-height: 1; color: var(--bs-primary); font-family: 'Dancing Script', cursive;">
            500
        </div>
        <i class="fas fa-screwdriver-wrench mb-3 d-block" style="font-size: 3rem; color: var(--bs-primary-text-emphasis);"></i>
        <h2 class="fw-bold mb-2">Something went wrong.</h2>
        <p class="text-muted mb-4" style="max-width: 400px; margin: 0 auto; font-family: 'Nunito', sans-serif;">
            We're sorry — something unexpected happened on our end. Please try again or head back home.
        </p>
        <a asp-action="Index" asp-controller="Home" class="btn btn-cart rounded-pill px-4 py-2 fw-semibold">
            <i class="fas fa-home me-2"></i> Back to Home
        </a>
    </div>
</div>
