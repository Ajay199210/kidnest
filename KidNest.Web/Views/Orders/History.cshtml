@model List<KidNest.Web.ViewModels.Orders.OrderIndexViewModel>

@{
    ViewData["Title"] = "History";
}

<div class="container min-vh-100 d-flex justify-content-center align-items-center">
    <div class="row w-100 justify-content-center">
        <div class="col-md-10 col-lg-8 m-4 p-5 pb-4 form-container rounded-5 rounded-sm-0">
            @if (Model.Count > 0)
            {
                <div class="text-center mb-4">
                    <h2 class="display-6">Orders History</h2>
                    <p class="fw-light fs-5">Click on an order to view it's details.</p>
                </div>

                <div class="accordion" id="ordersAccordion">
                    @foreach (var order in Model)
                    {
                        var collapseId = $"collapseOrder-{order.Id}";
                        var headingId = $"headingOrder-{order.Id}";

                        <div class="accordion-item mb-2">
                            <h2 class="accordion-header" id="@headingId">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">
                                    <div class="d-flex flex-column w-100">
                                        <div><strong>Order #@order.Id</strong> - @order.OrderDate?.ToString("yyyy-MM-dd")</div>
                                        <small class="text-muted">Status: @order.Status - Items: @order.OrderItemsCount</small>
                                        <small>Total: @order.OrderTotalPrice.ToString("C")</small>
                                    </div>
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId">
                                <div class="accordion-body bg-body-tertiary rounded">
                                    <div class="row g-3">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <div class="col-md-6">
                                                <div class="card shadow border-0 rounded">
                                                    <div class="card-body">
                                                        <h6 class="card-title text-decoration-underline">@item.ProductName</h6>
                                                        <p class="card-text mb-1">
                                                            <strong>Quantity:</strong> @item.Quantity
                                                        </p>
                                                        <p class="card-text mb-1">
                                                            <strong>Color:</strong>
                                                            @if(item.Color != null)
                                                            {
                                                                <span style="background-color:@item.ColorHex;" class="p-1 rounded text-light">@item.Color</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">N/A</span>
                                                            }
                                                        </p>
                                                        <p class="card-text mb-1">
                                                            <strong>Size:</strong>
                                                            @if(item.Size != null)
                                                            {
                                                                @item.Size
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">N/A</span>
                                                            }
                                                        </p>
                                                        <p class="card-text mb-1">
                                                            <strong>Unit Price:</strong> @item.Price.ToString("C")
                                                        </p>
                                                        @if(@item.Discount > 0)
                                                        {
                                                            <p class="card-text mb-1">
                                                                <strong>Discounted:</strong> @item.DiscountedPrice.ToString("C") (@item.Discount%)
                                                            </p>
                                                        }
                                                        <p class="card-text">
                                                            <strong>Total:</strong> @item.TotalPrice.ToString("C")
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center mb-3">
                    <h2 class="display-6">Orders History</h2>
                    <hr />
                    <p class="fw-light fs-4 fst-italic m-0">
                        You haven't placed any orders yet.
                        Browse our store to discover great products just for you!
                    </p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .container {
        background-image: url("../../img/store/store.png");
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center center;
        background-attachment: fixed;
        max-width: 100%;
        position: relative;
    }

        .container::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #000;
            opacity: 0.5;
            z-index: -1;
        }

    .form-container {
        background-color: rgba(var(--bs-primary-rgb), 0.9);
        color: black;
        width: 100%;
        max-width: 900px;
    }

    .accordion-button > div {
        text-align: left;
    }
</style>
