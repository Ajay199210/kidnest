@using System.Security.Claims;
@using System.Text.Json
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KidNest</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Nunito:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Header -->
    <header>
        @await Html.PartialAsync("_Header")
    </header>

    <!-- Main -->
    <main role="main" class="bg-primary">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer bg-white border-top shadow-sm">
        @await Html.PartialAsync("_Footer")
    </footer>

    <!-- Back to top -->
    <button id="backToTopBtn" class="btn back-to-top-btn position-fixed shadow-lg d-none" aria-label="Back to top">
        <i class="fas fa-chevron-up"></i>
    </button>

    <!-- Floating Filter Button (mobile only) -->
    <button class="btn filter-float-btn position-fixed shadow-lg d-lg-none d-none"
            id="filterFloatBtn"
            data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas"
            aria-label="Open filters">
        <i class="fas fa-sliders"></i>
    </button>

    <!-- Alerts & Toast Notification Containers -->
    @await Html.PartialAsync("_Notification")

    <!-- Filter Offcanvas (mobile) -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title fw-bold" id="filterOffcanvasLabel">
                <i class="fas fa-sliders me-2"></i>Filters
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            @await Html.PartialAsync("_FilterSidebarPartial")
        </div>
    </div>

    <!-- Cart Offcanvas -->
    @await Component.InvokeAsync("CartOffcanvas")

    <!-- Modal for order confirmation, initially hidden -->
    @await Component.InvokeAsync("OrderConfirmationModal")

    <!-- NToast Notification Component -->
    @await Component.InvokeAsync("NToastNotify")

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/lib/elevatezoom/jquery.elevatezoom.min.js"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/js/script.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                html: @Html.Raw(JsonSerializer.Serialize(TempData["Success"]))
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: '@TempData["Error"]',
                footer: '<a href="/help">Need help?</a>'
            });
        </script>
    }

    @if (TempData["Info"] != null)
    {
        <script>
            Swal.fire({
                icon: 'info',
                title: 'Info',
                text: '@TempData["Info"]',
                footer: '<a href="/account/register">Create a new account?</a>'
            });
        </script>
    }
</body>
</html>
