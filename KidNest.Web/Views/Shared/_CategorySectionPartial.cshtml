@model KidNest.Web.ViewModels.Home.CategorySectionViewModel

<div class="category-outer my-5 bg-light p-2 shadow">
    <div class="category-inner p-4 border-2" id="category-@Model.Id">
        <!-- Category Header -->
        <div class="d-flex justify-content-between align-items-center mb-3 px-2">
            <h2 class="fw-bold m-0">@Model.Name</h2>
            @if(Model.Products.Count >= 3)
            {
                <a asp-action="Details" asp-controller="Categories" asp-route-id="@Model.Id"
                   class="see-more-link fs-4">See more</a>
            }
        </div>

        <!-- Products -->
        <div class="row g-4">
            @foreach (var product in Model.Products)
            {
                <!-- 1 column on xs, 2 on sm/md, 3 on lg+ -->
                <div class="col-12 col-sm-6 col-lg-4">
                    @await Html.PartialAsync("_ProductCardPartial", product)
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Outer white box effect */
    .category-outer {
        border-radius: 1.5rem;
    }

    /* Inner light blue, translucent box */
    .category-inner {
        background: rgba(224, 240, 255, 0.25); /* Light transparent blue */
        border: 1px solid rgba(100, 149, 237, 0.5); /* Border inside */
        border-radius: 1.25rem;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        box-shadow: 0 2px 8px rgba(100, 149, 237, 0.1);
        transition: all 0.3s ease;
    }

    .see-more-link {
        color: rgb(0,109,235); /* Darker blue */
    }

    /* iPad-specific adjustments */
    @@media (min-width: 768px) and (max-width: 1180px) {
        .category-inner .row {
            --bs-gutter-x: 1.5rem; /* Adjust spacing */
        }
    }
</style>
