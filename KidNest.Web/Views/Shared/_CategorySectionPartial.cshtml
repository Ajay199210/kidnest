@model KidNest.Web.ViewModels.Home.CategorySectionViewModel

<div class="category-section my-2 my-md-3 rounded-1 p-3 p-md-4" id="category-@Model.Id">
    <!-- Category Header -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-2">
            <span class="category-accent-bar"></span>
            <h4 class="fw-bold m-0">@Model.Name</h4>
        </div>
        @if(Model.Products.Count >= 3)
        {
            <a asp-action="Details" asp-controller="Categories" asp-route-id="@Model.Id"
               class="btn btn-sm btn-cart rounded-pill px-3 text-nowrap">
                See more <i class="fas fa-arrow-right ms-1"></i>
            </a>
        }
    </div>
    <hr class="mt-1 mb-3 border-primary opacity-25" />

    <!-- Products -->
    <div class="row g-3 g-lg-4">
        @foreach (var product in Model.Products)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                @await Html.PartialAsync("_ProductCardPartial", product)
            </div>
        }
    </div>
</div>
