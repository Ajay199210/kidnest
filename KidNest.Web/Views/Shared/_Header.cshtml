@using System.Security.Claims
<div class="container-fluid px-0">
    <!-- Top Header: Contact Info Strip -->
    <div class="top-header-strip py-1">
        <div class="container-fluid px-2 px-md-4">
            <div class="d-flex justify-content-center align-items-center position-relative">
                <div class="contact-info">
                    @await Component.InvokeAsync("PublicSettings", new { section = "ContactInfo" })
                </div>
                <div class="d-none d-md-flex position-absolute end-0">
                    @await Component.InvokeAsync("PublicSettings", new { section = "SocialIcons" })
                </div>
            </div>
        </div>
    </div>

    <!-- Middle Header: Logo + Search + Actions -->
    <div class="middle-header bg-white py-2 py-md-1">
        <div class="container-fluid px-2 px-md-4">
            <div class="row align-items-center g-2 g-md-4">
                <!-- Logo -->
                <div class="col-12 col-md-3 col-lg-2 text-center text-md-start">
                    <a asp-action="Index" asp-controller="Home">
                        <img src="~/img/logo/logo.png" alt="KidNest" class="logo" />
                    </a>
                </div>

                <!-- Search Bar -->
                <div class="col-12 col-md-9 col-lg-6 d-flex justify-content-center justify-content-md-start">
                    @await Component.InvokeAsync("SearchBar")
                </div>

                <!-- User Actions -->
                <div class="col-12 col-lg-4">
                    <ul class="nav justify-content-center justify-content-md-end align-items-center gap-1 flex-nowrap">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            var userFullName = User.FindFirst(ClaimTypes.Name)?.Value;
                            <li class="nav-item dropdown">
                                <a class="nav-link header-action-link dropdown-toggle d-flex align-items-center gap-1"
                                    href="#" id="userDropdown" role="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-circle-user fa-lg"></i>
                                    <span class="d-none d-lg-inline">@userFullName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userDropdown">
                                    <li class="dropdown-header small text-muted">Hello, @userFullName!</li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-action="Update" asp-controller="Account">
                                            <i class="fa-solid fa-gear me-2 text-muted"></i> Account Settings
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-action="History" asp-controller="Orders">
                                            <i class="fa-solid fa-clock-rotate-left me-2 text-muted"></i> Orders History
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-action="Logout" asp-controller="Account" method="post">
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="fa-solid fa-right-from-bracket me-2"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a asp-action="Login" asp-controller="Account"
                                   class="btn btn-outline-primary btn-sm rounded-pill px-3 header-btn">
                                    <i class="fa-solid fa-right-to-bracket me-1"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Register" asp-controller="Account"
                                   class="btn btn-primary btn-sm rounded-pill px-3 header-btn">
                                    <i class="fa-solid fa-user-plus me-1"></i> Register
                                </a>
                            </li>
                        }

                        <li class="nav-item ms-1">
                            <button class="btn btn-cart btn-sm rounded-pill position-relative px-3"
                                    type="button" data-bs-toggle="offcanvas"
                                    data-bs-target="#cartOffcanvas" aria-controls="cartOffcanvas">
                                <i class="fa-solid fa-cart-shopping"></i>
                                <span class="ms-1">Cart</span>
                                <span class="badge text-bg-warning rounded-pill ms-1" id="cartCount">0</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Header: Navigation Bar -->
    <nav class="bottom-header border-top">
        <div class="container-fluid px-2 px-md-4">
            <!-- Desktop nav -->
            <div class="d-none d-md-flex justify-content-between align-items-center">
                <ul class="nav header-nav flex-nowrap">
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Home" class="nav-link px-3 py-2">
                            <i class="fas fa-th-large me-1"></i> All
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="HotDeals" asp-controller="Products" class="nav-link px-3 py-2">
                            <i class="fas fa-fire text-danger me-1"></i> Hot Deals
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="NewReleases" asp-controller="Products" class="nav-link px-3 py-2">
                            <i class="fas fa-star text-warning me-1"></i> New Releases
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Mobile: burger + social -->
            <div class="d-flex d-md-none justify-content-between align-items-center py-1">
                <button class="header-toggler" type="button" id="headerNavToggle" aria-label="Toggle navigation">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="d-flex">
                    @await Component.InvokeAsync("PublicSettings", new { section = "SocialIcons" })
                </div>
            </div>

            <!-- Mobile collapsible nav -->
            <div class="d-md-none header-nav-collapse" id="headerNavMenu">
                <ul class="nav header-nav">
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Home" class="nav-link">
                            <i class="fas fa-th-large me-1"></i> All
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="HotDeals" asp-controller="Products" class="nav-link">
                            <i class="fas fa-fire text-danger me-1"></i> Hot Deals
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="NewReleases" asp-controller="Products" class="nav-link">
                            <i class="fas fa-star text-warning me-1"></i> New Releases
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</div>