@model KidNest.Web.ViewModels.Components.SearchBarViewModel

<form asp-controller="Home" asp-action="Index" method="get" class="w-100">
    <div class="input-group rounded-pill">
        <input type="hidden" name="categoryId" id="categoryIdInput" value="@Model.SelectedCategoryId" />

        <button class="btn btn-secondary dropdown-toggle rounded-start-pill text-bg-light category-btn-filter"
                type="button" data-bs-toggle="dropdown" aria-expanded="false">
            @(Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedCategoryId)?.Name ?? "All")
        </button>

        <ul class="dropdown-menu">
            <li><a class="dropdown-item category-option" href="#" data-id="">All</a></li>
            @foreach (var category in Model.Categories)
            {
                <li>
                    <a class="dropdown-item category-option" href="#" data-id="@category.Id">@category.Name</a>
                </li>
            }
        </ul>

        <input type="text" name="query" class="form-control" value="@Model.SearchTerm" 
            placeholder="Search products..." />

        <button type="submit" class="input-group-text rounded-end-pill btn btn-primary">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>
    </div>
</form>
