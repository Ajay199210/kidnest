@model KidNest.Web.ViewModels.Settings.PublicSettingsViewModel

<div class="parallax-section">
    <div class="parallax-image"></div>
</div>

<style>
/* Parallax section */
.parallax-section {
    height: 300px;
    /* Fixed height for parallax container */
    overflow: hidden;
    position: relative;
}

.parallax-image {
    background-image: url("../../../../uploads/img/parallax/@Model.ParallaxImage");
    background-attachment: fixed;
    background-position: center top;
    background-size: cover;
    height: 100%;
    /* image extends beyond container */
    width: 100%;
    opacity: 0.9;
}
</style>