@model KidNest.Web.ViewModels.Home.ProductCardViewModel

<div id="product-@Model.Id"
    class="card product-card h-100 d-flex flex-column rounded-4 shadow-sm">

    <!-- Image -->
    <div class="card-img-container rounded-top-4 overflow-hidden">
        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">
            <img src="@Model.ImagePath" class="card-img-top h-100 w-100 object-fit-cover" alt="@Model.Name">
        </a>
    </div>

    <div class="card-body d-flex flex-column px-3 pt-3 pb-2">
        <!-- Discount Badge + Title -->
        <div class="d-flex align-items-start gap-2 mb-1">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="text-dark text-decoration-none flex-grow-1">
                <h6 class="card-title fw-semibold mb-0">@Model.Name</h6>
            </a>
            @if (Model.Discount != null)
            {
                <span class="badge text-bg-warning rounded-pill px-2 py-1 fw-bold text-nowrap">
                    @Model.Discount% off
                </span>
            }
        </div>

        <!-- Description -->
        <p class="card-text text-muted small mb-2 flex-grow-1 card-description">
            @Model.ShortDescription
        </p>

        <!-- Colors/Sizes -->
        @if ((Model.DistinctColors.Count > 0) || (Model.DistinctSizes.Count > 0))
        {
            <div class="mb-2">
                @if (Model.DistinctColors.Count > 0)
                {
                    <div class="d-flex flex-wrap mb-2 gap-2">
                        @for (int i = 0; i < Model.DistinctColors.Count; i++)
                        {
                            var color = Model.DistinctColors[i];
                            var inputId = $"colorOption-{Model.Id}-{i+1}";

                            <label class="form-check-label">
                                <input type="radio"
                                    class="btn-check"
                                    name="selectedColor-@Model.Id"
                                    id="@inputId"
                                    value="@color.Color"
                                    data-color-id="@color.ColorId"
                                    autocomplete="off"
                                    @(i == 0 ? "checked" : "") />
                                <span class="color-circle-picker rounded-circle d-inline-block border border-2"
                                      style="background-color: @color.ColorHex;"></span>
                            </label>
                        }
                    </div>
                }

                @if (Model.DistinctSizes.Count > 0)
                {
                    <div class="d-flex flex-wrap mb-2 gap-1">
                        @for(int i = 0; i < Model.DistinctSizes.Count; i++)
                        {
                            var size = Model.DistinctSizes[i];
                            var inputId = $"sizeOption-{Model.Id}-{i+1}";

                            <input type="radio"
                               class="btn-check"
                               name="selectedSize-@Model.Id"
                               id="@inputId"
                               value="@size.SizeCode"
                               data-size-id="@size.SizeId"
                               autocomplete="off"
                               @(i == 0 ? "checked" : "") />

                            <label class="btn btn-outline-primary px-2 py-0 rounded-pill small"
                                   for="@inputId">
                                @size.SizeCode
                            </label>
                        }
                    </div>
                }
            </div>
        }

        <!-- Price & Add to Cart -->
        <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
            @if (Model.Discount != null)
            {
                <p class="fw-bold card-text fs-5 m-0">
                    @{
                        var priceParts = @Model.FinalPrice.ToString("F2").Split('.');
                    }
                    $@(priceParts[0])<sup class="fw-semibold"><small>@(priceParts[1])</small></sup>
                    <small class="fw-light text-muted fs-6">
                        <span class="text-decoration-line-through">$@Model.Price</span>
                    </small>
                </p>
            }
            else
            {
                <p class="fw-bold card-text fs-5 m-0">
                    @{
                        var priceParts = Model.Price.ToString("F2").Split('.');
                    }
                    $@(priceParts[0])<sup class="fw-semibold"><small>@(priceParts[1])</small></sup>
                </p>
            }
            <button class="btn btn-sm rounded-pill px-3 py-1 add-to-cart btn-cart text-nowrap"
                    data-id="@Model.Id"
                    data-name="@Model.Name"
                    data-img="@Model.ImagePath"
                    data-price="@Model.FinalPrice"
                    data-max="@Model.Quantity">
                <i class="fa-solid fa-cart-plus me-1"></i> Add
            </button>
        </div>
    </div>
</div>