@model KidNest.Web.ViewModels.Home.ProductCardViewModel

<div id="product-@Model.Id"
    class="card product-card h-100 d-flex flex-column border-2 border-primary rounded-4 shadow">
    <div class="card-img-container p-3 pb-0">
        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">
            <img src="@Model.ImagePath" class="card-img-top h-100 w-100 object-fit-cover p-0 rounded" alt="@Model.Name">
        </a>
    </div>
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="text-dark text-decoration-none">
                <h5 class="card-title m-0">@Model.Name</h5>
            </a>
            @if (Model.Discount != null)
            {
                <span href="#" class="badge text-bg-warning fs-6 fw-bold fst-italic">@Model.Discount% off</span>
            }
        </div>

        <p class="card-text mt-4 flex-grow-1">
            @Model.ShortDescription
        </p>

        <!-- Colors/Sizes -->
        @if ((Model.DistinctColors.Count > 0) || (Model.DistinctSizes.Count > 0))
        {
            <div class="mb-3">
                @if (Model.DistinctColors.Count > 0)
                {
                    <div class="d-flex flex-wrap my-2 gap-2">
                        @for (int i = 0; i < Model.DistinctColors.Count; i++)
                        {
                            var color = Model.DistinctColors[i];
                            var inputId = $"colorOption-{Model.Id}-{i+1}"; // Unique per product card

                            <label class="form-check-label">
                                <input type="radio"
                                    class="btn-check"
                                    name="selectedColor-@Model.Id"
                                    id="@inputId"
                                    value="@color.Color"
                                    data-color-id="@color.ColorId"
                                    autocomplete="off"
                                    @(i == 0 ? "checked" : "") />
                                <span class="color-circle-picker rounded-circle d-inline-block border border-2 border-dark"
                                      style="background-color: @color.ColorHex;"></span>
                            </label>
                        }
                    </div>
                }

                @if (Model.DistinctSizes.Count > 0)
                {
                    <div class="d-flex flex-wrap my-2 gap-1">
                        @for(int i = 0; i < Model.DistinctSizes.Count; i++)
                        {
                            var size = Model.DistinctSizes[i];
                            var inputId = $"sizeOption-{Model.Id}-{i+1}"; // Unique per product card

                            <input type="radio"
                               class="btn-check"
                               name="selectedSize-@Model.Id"
                               id="@inputId"
                               value="@size.SizeCode"
                               data-size-id="@size.SizeId"
                               autocomplete="off"
                               @(i == 0 ? "checked" : "") />

                            <label class="btn btn-outline-secondary px-3 py-1 rounded-pill"
                                   for="@inputId">
                                @size.SizeCode
                            </label>
                        }
                    </div>
                }
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mt-auto">
            @if (Model.Discount != null)
            {
                <p class="fw-bold card-text fs-5 m-0 align-self-center w-100">
                    @{
                        var priceParts = @Model.FinalPrice.ToString("F2").Split('.');
                    }
                    $@(priceParts[0])<sup class="fw-semibold"><small>@(priceParts[1])</small></sup>
                    <small class="fw-light text-dark fs-6">
                        List: <span class="text-decoration-line-through">@Model.Price</span>
                    </small>
                </p>
            }
            else
            {
                <p class="fw-bold card-text fs-5 m-0 align-self-center w-100">
                    @{
                        var priceParts = Model.Price.ToString("F2").Split('.');
                    }
                    $@(priceParts[0])<sup class="fw-semibold"><small>@(priceParts[1])</small></sup>
                </p>
            }
            <button class="btn btn-dark align-self-center add-to-cart"
                    data-id="@Model.Id"
                    data-name="@Model.Name"
                    data-img="@Model.ImagePath"
                    data-price="@Model.FinalPrice"
                    data-max="@Model.Quantity">
                <i class="fa-solid fa-cart-plus"></i>
            </button>
        </div>
    </div>
</div>