<div class="container-fluid px-3 px-md-5">
    <!-- Main Footer -->
    <div class="row py-4 g-4">
        <!-- Logo & Tagline -->
        <div class="col-12 col-md-4 text-center text-md-start">
            <a href="/" class="d-inline-block mb-2">
                <img src="~/img/logo/logo.png" alt="KidNest" class="footer-logo">
            </a>
            <p class="text-dark mb-0">Toys & joy for little ones.</p>
        </div>

        <!-- Quick Links -->
        <div class="col-6 col-md-4 text-center">
            <h5 class="fw-bold text-dark mb-3">Quick Links</h5>
            <ul class="nav flex-column gap-1 align-items-center">
                <li class="nav-item"><a asp-action="Index" asp-controller="Home" class="nav-link footer-link p-0">Home</a></li>
                <li class="nav-item"><a asp-action="NewReleases" asp-controller="Products" class="nav-link footer-link p-0">New Releases</a></li>
                <li class="nav-item"><a asp-action="HotDeals" asp-controller="Products" class="nav-link footer-link p-0">Hot Deals</a></li>
            </ul>
        </div>

        <!-- Contact & Social -->
        <div class="col-6 col-md-4 text-center text-md-center">
            <h5 class="fw-bold text-dark mb-3">Contact</h5>
            <div class="footer-contact mb-3">
                @await Component.InvokeAsync("PublicSettings", new { section = "ContactInfo" })
            </div>
            <div class="d-flex justify-content-center justify-content-md-center">
                @await Component.InvokeAsync("PublicSettings", new { section = "SocialIcons" })
            </div>
        </div>
    </div>

    <!-- Bottom Bar -->
    <div class="text-center py-3 border-top">
        <small class="text-dark">&copy; @DateTime.Now.Year KidNest, Inc. All rights reserved.</small>
    </div>
</div>