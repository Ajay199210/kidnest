@model KidNest.Web.ViewModels.Products.ProductViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4 px-3 px-md-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a class="text-dark text-decoration-none" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home me-1"></i>Home
                </a>
            </li>
            <li class="breadcrumb-item">
                <a class="text-dark text-decoration-none" asp-controller="Categories" asp-action="Details"
                    asp-route-id="@Model.CategoryId">@Model.CategoryName</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-4 g-lg-5">
        <!-- Product Image -->
        <div class="col-md-6">
            <div class="product-image-wrapper rounded-4 overflow-hidden shadow-sm bg-white p-3">
                <img src="@Model.ImagePath" alt="@Model.Name"
                     class="img-fluid prod-img rounded-3 w-100 object-fit-contain" />
            </div>
            <!-- Description below image -->
            <div class="mt-4">
                <h6 class="fw-bold mb-2">Description</h6>
                <p class="text-muted text-break mb-0">@Model.Description</p>
            </div>
        </div>

        <!-- Product Details -->
        <div class="col-md-6">
            <!-- Category link -->
            <a asp-action="Details" asp-controller="Categories" asp-route-id="@Model.CategoryId"
               class="badge rounded-pill text-bg-primary text-decoration-none mb-2 d-inline-block px-3 py-1">
                @Model.CategoryName
            </a>

            <h2 class="fw-bold mb-3">@Model.Name</h2>

            <!-- Price and Discount -->
            <div class="mb-4">
                @if (Model.Discount > 0)
                {
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <h3 class="fw-bold mb-0">$@Model.DiscountedPrice?.ToString("F2")</h3>
                        <span class="text-muted text-decoration-line-through fs-5">$@Model.Price</span>
                        <span class="badge text-bg-warning rounded-pill px-3 py-2 fw-bold">@Model.Discount% off</span>
                    </div>
                }
                else
                {
                    <h3 class="fw-bold mb-0">$@Model.Price</h3>
                }
            </div>

            @if (Model.Quantity > 0)
            {
                <!-- Stock Status -->
                <p class="mb-3">
                    <span class="badge text-bg-success rounded-pill px-3 py-2">
                        <i class="fas fa-check-circle me-1"></i> In Stock
                    </span>
                </p>

                <!-- Add to Cart Box -->
                <div class="rounded-4 border p-4 bg-white shadow-sm">
                    <form id="addToCartForm">
                        <input type="hidden" id="productId" value="@Model.Id" />
                        <input type="hidden" id="productName" value="@Model.Name" />
                        <input type="hidden" id="productImage" value="@Model.ImagePath" />
                        <input type="hidden" id="productPrice"
                            value="@((Model.DiscountedPrice > 0 ? Model.DiscountedPrice : Model.Price))" />

                        <!-- Product Variants -->
                        @if (Model.DistinctColors.Count > 0 || Model.DistinctSizes.Count > 0)
                        {
                            <div class="d-flex flex-column gap-3 mb-3">
                                @if (Model.DistinctColors.Count > 0)
                                {
                                    <div>
                                        <label class="form-label fw-semibold small mb-2">Color</label>
                                        <div class="d-flex flex-wrap gap-2">
                                            @for (int i = 0; i < Model.DistinctColors.Count; i++)
                                            {
                                                var color = Model.DistinctColors[i];
                                                var inputId = $"colorOption{i+1}";

                                                <input type="radio" class="btn-check" name="selectedColor" id="@inputId"
                                                       value="@color.Color" data-color-id=@color.ColorId
                                                       autocomplete="off" @(i == 0 ? "checked" : "") />
                                                <label class="btn btn-outline-secondary rounded-pill d-flex align-items-center gap-2 px-3 py-1" for="@inputId">
                                                    <span class="rounded-circle d-inline-block border border-2"
                                                          style="background-color: @color.ColorHex; width: 18px; height: 18px;"></span>
                                                    <span class="small">@color.Color</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (Model.DistinctSizes.Count > 0)
                                {
                                    <div>
                                        <label class="form-label fw-semibold small mb-2">Size</label>
                                        <div class="d-flex flex-wrap gap-2">
                                            @for (int i = 0; i < Model.DistinctSizes.Count; i++)
                                            {
                                                var size = Model.DistinctSizes[i];
                                                var inputId = $"sizeOption{i+1}";

                                                <input type="radio" class="btn-check" name="selectedSize"
                                                    id="@inputId" value="@size.SizeCode"
                                                    data-size-id=@size.SizeId autocomplete="off"
                                                    @(i == 0 ? "checked" : "")>
                                                <label class="btn btn-outline-primary rounded-pill px-3 py-1" for="@inputId">
                                                    @size.SizeCode
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Quantity -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small mb-2">Quantity</label>
                            <input type="number" id="quantityInput" value="1" min="1" max="@Model.Quantity"
                                class="form-control rounded-pill" style="max-width: 100px;" />
                        </div>
                        <span id="quantityValidation" class="text-danger small"></span>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-3 mt-3">
                            <button type="button" class="btn btn-cart w-100 rounded-pill fw-bold py-2 add-to-cart"
                                    data-id="@Model.Id"
                                    data-name="@Model.Name"
                                    data-img="@Model.ImagePath"
                                    data-price="@(Model.DiscountedPrice > 0 ? Model.DiscountedPrice : Model.Price)">
                                <i class="fa-solid fa-cart-plus me-1"></i> Add to Cart
                            </button>
                            <button type="button" class="btn btn-warning w-100 rounded-pill fw-bold py-2" id="btnBuyNow"
                                    data-id="@Model.Id"
                                    data-name="@Model.Name"
                                    data-price="@(Model.DiscountedPrice > 0 ? Model.DiscountedPrice : Model.Price)">
                                <i class="fa-solid fa-bolt me-1"></i> Buy Now
                            </button>
                        </div>
                    </form>
                </div>

                <p class="text-muted small fst-italic mt-3 mb-0">
                    <i class="fa-solid fa-truck me-1"></i>
                    Estimated delivery time is provided by the shipping carrier and may vary by location.
                </p>
            }
            else
            {
                <div class="rounded-4 border border-danger-subtle p-4 bg-danger-subtle">
                    <p class="mb-1 fw-bold text-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i> Out of Stock
                    </p>
                    <p class="text-muted small mb-0">This item is currently unavailable.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Parallax Section -->
@await Component.InvokeAsync("PublicSettings", new { section = "Parallax" })

<!-- Scripts -->
@section Scripts {
    <script>
        const productVariants = @Html.Raw(Json.Serialize(Model.Variants))
    </script>
}